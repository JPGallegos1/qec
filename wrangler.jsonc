{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qec",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "queestanconstruyendo.com",
      "custom_domain": true
    },
    {
      "pattern": "www.queestanconstruyendo.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // Boolean `true` breaks local Vite (`/@vite/client`, `/src/**` → 404).
    // Only API routes need the Worker ahead of assets.
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "918271",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
