---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const issues = (await getCollection('issues', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Ediciones" description="Archivo de ediciones de Qué Están Construyendo.">
  <section class="archive-page shell">
    <header>
      <h1>Ediciones</h1>
      <p>Cada despacho conserva sus fuentes, contexto y marcas de patrocinio. La edición cero es una demostración del formato.</p>
    </header>
    <ol>
      {issues.map((issue) => (
        <li>
          <a href={`/ediciones/${issue.id}/`}>
            <span>Nº {String(issue.data.issueNumber).padStart(2, '0')}</span>
            <div>
              <strong>{issue.data.title}</strong>
              <p>{issue.data.description}</p>
            </div>
            <time datetime={issue.data.publishedAt.toISOString()}>{issue.data.dateLabel}</time>
            {issue.data.demo && <span class="data-tag data-tag--demo">Demostración</span>}
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .archive-page {
    min-height: 72vh;
    padding-block: clamp(70px, 10vw, 130px);
  }

  header {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 50px;
    align-items: end;
    margin-bottom: 70px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 8vw, 5rem);
    font-weight: 500;
    font-variation-settings: "opsz" 100;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  header p {
    max-width: 56ch;
    margin: 0;
    color: #5f584f;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  li a {
    display: grid;
    grid-template-columns: 72px 1fr 130px auto;
    gap: 24px;
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  li a:hover {
    color: var(--color-brand-deep);
  }

  li a > span:first-child,
  time {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  strong {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.6vw, 1.85rem);
    font-weight: 500;
  }

  li p {
    max-width: 68ch;
    margin: 7px 0 0;
    color: #6c645b;
    font-family: var(--font-serif);
    line-height: 1.55;
  }

  @media (max-width: 700px) {
    header {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    li a {
      grid-template-columns: 50px 1fr;
    }

    time,
    li :global(.data-tag) {
      display: none;
    }
  }
</style>
