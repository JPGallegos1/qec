---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import { Image } from 'astro:assets';
import logo from '../assets/logo-qec.png';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageEvent?: string;
}

const {
  title = 'Qué Están Construyendo',
  description = 'Una curaduría quincenal sobre lo que construyen startups, founders e indie hackers vinculados con Argentina.',
  pageEvent,
} = Astro.props;
const pageTitle = title === 'Qué Están Construyendo' ? title : `${title} | Qué Están Construyendo`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'hola@qec.example';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Qué Están Construyendo',
  alternateName: 'QEC',
  url: Astro.site?.toString(),
  description,
  inLanguage: 'es-AR',
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf6ef" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Qué Están Construyendo" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body data-page-event={pageEvent}>
    <!--
      THESIS: QEC reads like an independent Argentine publication, not a startup dashboard or a generic newsletter funnel.
      OWN-WORLD: warm paper, white editorial surfaces, ink serif headlines, orange brand actions, and mono metadata.
      STORY: understand the promise, subscribe, verify the editorial filter, inspect the demonstration issue, then submit a real signal.
      FIRST VIEWPORT: a quiet masthead gives way to one large Newsreader statement, a concise editorial description, and the working subscription form.
      FORM: Editorial paper system pinned by the user's visual guidelines; it replaces the previous Bitácora de señales world.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <header class="site-header">
      <div class="site-header__inner shell">
        <a class="wordmark" href="/" aria-label="Qué Están Construyendo, inicio">
          <span class="brand-logo" aria-hidden="true">
            <Image src={logo} alt="" width={114} height={76} format="webp" />
          </span>
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="/ediciones/">Archivo</a>
          <a class="button" href="/#suscribirme">Suscribirme</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner shell">
        <a class="footer-brand" href="/" aria-label="Qué Están Construyendo, inicio">
          <span class="brand-logo" aria-hidden="true">
            <Image src={logo} alt="" width={114} height={76} format="webp" />
          </span>
        </a>
        <nav aria-label="Enlaces legales">
          <a href="/ediciones/">Archivo</a>
          <a href="/privacidad/">Privacidad</a>
          <a href={`mailto:${contactEmail}`}>Contacto</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
