---
interface Props {
  source?: string;
}

const { source = 'landing' } = Astro.props;
---

<form
  class="subscription-form"
  action="/api/subscribe"
  method="post"
  data-qec-form="subscription"
  data-start-event="subscription_started"
  data-complete-event="subscription_completed"
>
  <input type="hidden" name="source" value={source} />
  <div class="subscription-form__row">
    <div class="field subscription-form__field">
      <label class="sr-only" for={`subscription-email-${source}`}>Tu email</label>
      <input
        id={`subscription-email-${source}`}
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="tu@email.com"
        required
      />
    </div>
    <button class="button" type="submit" data-loading-label="Suscribiendo...">Suscribirme</button>
  </div>
  <div class="sr-only" aria-hidden="true">
    <label for={`subscription-company-${source}`}>Empresa</label>
    <input id={`subscription-company-${source}`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <label class="consent">
    <input name="consent" type="checkbox" required />
    <span>Acepto recibir QEC cada 15 días. Sin spam y con baja en un clic.</span>
  </label>
  <p class="form-status" data-form-status role="status" aria-live="polite"></p>
</form>

<style>
  .subscription-form {
    width: min(640px, 100%);
  }

  .subscription-form__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }

  .subscription-form__field :global(input) {
    min-height: 46px;
  }

  .subscription-form :global(.consent) {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
  }

  .subscription-form :global(.form-status) {
    margin-top: 5px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  @media (max-width: 520px) {
    .subscription-form__row {
      grid-template-columns: 1fr;
    }

    .subscription-form__row :global(.button) {
      width: 100%;
    }
  }
</style>
